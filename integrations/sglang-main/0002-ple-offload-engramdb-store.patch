+class Qwen4ExpEngramDbEmbedding(Qwen4ExpStagedFileEmbedding):
+    """File-backed PLE table served by an EngramDB store directory.
+
+    Same graph break and same staging contract as ``file-staged``, but the rows
+    come from an `engramdb.Store` (``--ple-offload-dir`` points at it) instead of
+    a single mapping, so the table never has to exist as one 51.2 GiB file and
+    the read goes through the store's own concurrent reader. The store's shape is
+    checked against the engine's vocabulary geometry before anything is served.
+
+    The staging slab stays in the table's dtype and the cast to bf16 happens on
+    the device. A cross-device copy that also casts is far more expensive than
+    the cast itself -- 456 us against 39 for 2048 rows -- so the publish is two
+    plain copies with a device cast in between.
+    """
+
+    def __init__(
+        self,
+        embedding: VocabParallelEmbedding,
+        *,
+        store_root: str,
+        threads: Optional[int] = None,
+    ) -> None:
+        nn.Module.__init__(self)
+        self._adopt_embedding(embedding)
+        self._table_dtype = embedding.weight.dtype
+        row_bytes = self.embedding_dim * torch.empty(
+            0, dtype=self._table_dtype
+        ).element_size()
+        self._store = open_ple_engramdb_store(
+            store_root,
+            width=row_bytes,
+            rows=self.num_embeddings_per_partition,
+            threads=threads,
+        )
+        # Nothing to prefetch or trim: the store owns its own fds and the kernel
+        # page cache is not the residency this backend depends on.
+        self._file_prefetcher = None
+        self._staging = None
+        self._staging_rows = 0
+        self._dev_stage = None
+        self.register_buffer(
+            "weight_scale", embedding.weight_scale, persistent=True
+        )
+        del embedding.weight
+
+    def _staging_slab(self, rows: int) -> torch.Tensor:
+        if self._staging_rows < rows:
+            self._staging_rows = max(rows, self._STAGING_ROWS_FLOOR)
+            self._staging = torch.empty(
+                (self._staging_rows, self.embedding_dim),
+                dtype=self._table_dtype,
+                pin_memory=True,
+            )
+        return self._staging[:rows]
+
+    def _rows_from_bytes(self, raw: bytes, rows: int) -> torch.Tensor:
+        row_bytes = self.embedding_dim * torch.empty(
+            0, dtype=self._table_dtype
+        ).element_size()
+        if len(raw) != rows * row_bytes:
+            raise RuntimeError(
+                f"PLE store returned {len(raw)} B for {rows} rows of {row_bytes} B"
+            )
+        return (
+            torch.frombuffer(bytearray(raw), dtype=torch.uint8)
+            .view(self._table_dtype)
+            .view(-1, self.embedding_dim)
+        )
+
+    def _read_rows(self, host_ids: torch.Tensor) -> torch.Tensor:
+        """Rows of ``host_ids`` (host, long) as a pinned slab of the table dtype.
+
+        Other ranks' ids read as zero, as in the mapping backends.
+        """
+        start = int(self.shard_indices.org_vocab_start_index)
+        end = int(self.shard_indices.org_vocab_end_index)
+        rows = host_ids.numel()
+        staged = self._staging_slab(rows)
+        in_shard = (host_ids >= start) & (host_ids < end)
+        if bool(in_shard.all()):
+            # One store for the whole vocabulary: no masking, no zeroing.
+            staged.copy_(
+                self._rows_from_bytes(
+                    self._store.fetch((host_ids - start).tolist()), rows
+                )
+            )
+        else:
+            staged.zero_()
+            if bool(in_shard.any()):
+                keep = in_shard.nonzero(as_tuple=True)[0]
+                local = (host_ids[keep] - start).tolist()
+                staged[keep] = self._rows_from_bytes(
+                    self._store.fetch(local), len(local)
+                )
+        return staged
+
+    def _publish(self, staged: torch.Tensor, output: torch.Tensor) -> None:
+        rows = staged.shape[0]
+        if self._dev_stage is None or self._dev_stage.shape[0] < rows:
+            self._dev_stage = torch.empty(
+                (max(rows, self._STAGING_ROWS_FLOOR), self.embedding_dim),
+                dtype=self._table_dtype,
+                device=output.device,
+            )
+        self._dev_stage[:rows].copy_(staged, non_blocking=False)
+        output.view(-1, self.embedding_dim).copy_(self._dev_stage[:rows])
+
+    @eager_on_graph(True, capture_stub=_ple_staged_capture_stub)
+    def gather(
+        self, input_ids: torch.Tensor, out: Optional[torch.Tensor] = None
+    ) -> torch.Tensor:
+        output = self._resolve_gather_output(input_ids, out)
+
+        flat_ids = input_ids.reshape(-1).long()
+        if flat_ids.numel():
+            self._publish(self._read_rows(flat_ids.detach().cpu()), output)
+        return output
+
