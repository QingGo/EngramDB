+def open_ple_engramdb_store(
+    store_root: str,
+    *,
+    width: int,
+    rows: int,
+    threads: Optional[int] = None,
+):
+    """Open an EngramDB store directory as a PLE row source.
+
+    ``engramdb`` is an optional dependency: it is imported here rather than at
+    module scope so the other backends stay usable without it. The store's
+    geometry is checked against the engine's, because a mismatch would be served
+    silently as the wrong rows.
+    """
+    try:
+        import engramdb  # type: ignore
+    except ImportError as exc:  # pragma: no cover - depends on the deployment
+        raise RuntimeError(
+            "--ple-offload-backend engramdb needs the engramdb package: "
+            "pip install engramdb"
+        ) from exc
+
+    store_root = os.path.expanduser(store_root)
+    manifest_path = os.path.join(store_root, "manifest.json")
+    if os.path.exists(manifest_path):
+        with open(manifest_path) as handle:
+            manifest = json.load(handle)
+        shards = int(manifest["num_shards"])
+        rows_per_shard = int(manifest["expected_shard_bytes"]) // int(width)
+    else:
+        shard_names = sorted(glob.glob(os.path.join(store_root, "shard_*.bin")))
+        if not shard_names:
+            raise ValueError(
+                f"no PLE store in {store_root}: expected manifest.json or shard_*.bin"
+            )
+        shards = len(shard_names)
+        rows_per_shard = os.path.getsize(shard_names[0]) // int(width)
+
+    kwargs = {"threads": int(threads)} if threads else {}
+    store = engramdb.Store(
+        store_root,
+        shards=shards,
+        rows_per_shard=rows_per_shard,
+        width=int(width),
+        **kwargs,
+    )
+    if int(store.width) != int(width):
+        raise ValueError(
+            f"PLE store row width is {store.width} B, engine needs {width} B"
         )
+    if int(store.total_rows) != int(rows):
+        raise ValueError(
+            f"PLE store holds {store.total_rows} rows, engine vocabulary is {rows}"
+        )
+    logger.info(
+        "PLE table: engramdb store %s (%d shards x %d rows x %d B)",
+        store_root,
+        shards,
+        rows_per_shard,
+        width,
+    )
+    return store
 
 
