+def _ple_staged_capture_stub(
+    embedding: "Qwen4ExpStagedFileEmbedding",
+    input_ids: torch.Tensor,
+    out: Optional[torch.Tensor] = None,
+) -> torch.Tensor:
+    """Hand capture the buffer replay will publish into, without reading.
+
+    The body produces no kernels and its input is not known on the host until
+    the preceding segment has run, so there is nothing to capture; capture only
+    has to fix the address the following segment reads.
+    """
+    return embedding._resolve_gather_output(input_ids, out)
+
+
+class Qwen4ExpStagedFileEmbedding(Qwen4ExpPinnedHostEmbedding):
+    """File-backed PLE table read by the *host*, for devices without HMM.
+
+    ``Qwen4ExpPinnedHostEmbedding`` fetches rows with a Triton kernel that
+    dereferences the table through the device's address space, so the table must
+    either be pinned (the whole 47.7 GiB resident) or the device must walk host
+    page tables (GB10-class). A discrete GPU has neither. This subclass keeps
+    the same sparse file, allocator, page-cache hint and resident-set trimmer as
+    ``--ple-offload-backend file`` and moves the dereference to the host: the
+    ids come back, the rows are read out of the mapping into a pinned slab, and
+    one pinned-to-device copy lands them in the buffer the following graph
+    segment reads. Row granularity keeps an fp8 and a bf16 table on one path;
+    the gather kernel makes the same bf16 cast and the caller applies
+    ``weight_scale`` either way.
+
+    The host round trip is why ``gather`` is eager. ``eager_on_graph`` records
+    the call during capture and re-runs it between segment replays, which is
+    also what makes the copies legal: a break fn runs with no capture active, so
+    they are ordinary stream-ordered work. It therefore requires a breakable
+    CUDA graph (``--cuda-graph-backend-decode breakable``, and the prefill
+    equivalent); under a plain capture the decorator is inert and the body's
+    device-to-host copy fails the capture rather than silently replaying the
+    first gather's rows.
+    """
+
+    # A decode batch is a few hundred rows; the floor keeps the slab from being
+    # reallocated every step. Grown, never shrunk, to the largest gather seen.
+    _STAGING_ROWS_FLOOR = 4096
+
+    def __init__(
+        self,
+        embedding: VocabParallelEmbedding,
+        *,
+        backend: str = "file-staged",
+        table_dir: Optional[str] = None,
+    ) -> None:
+        super().__init__(embedding, backend=backend, table_dir=table_dir)
+        self._staging: Optional[torch.Tensor] = None
+        self._staging_rows = 0
+
+    def _staging_slab(self, rows: int) -> torch.Tensor:
+        """Pinned rows-per-copy target: the host side of the publish."""
+        if self._staging_rows < rows:
+            self._staging_rows = max(rows, self._STAGING_ROWS_FLOOR)
+            self._staging = torch.empty(
+                (self._staging_rows, self.embedding_dim),
+                dtype=torch.bfloat16,
+                pin_memory=True,
+            )
+        return self._staging[:rows]
+
+    def _read_rows(self, host_ids: torch.Tensor) -> torch.Tensor:
+        """Rows of ``host_ids`` (host, long) as bf16; other ranks' rows are 0.
+
+        This is where the table is actually touched, so this is where a cold
+        decode step takes its page faults.
+        """
+        start = int(self.shard_indices.org_vocab_start_index)
+        end = int(self.shard_indices.org_vocab_end_index)
+        staged = self._staging_slab(host_ids.numel())
+        staged.zero_()
+        in_shard = (host_ids >= start) & (host_ids < end)
+        if bool(in_shard.any()):
+            row_bytes = self.embedding_dim * self.weight.element_size()
+            raw = self.weight.data.view(torch.uint8).reshape(-1, row_bytes)
+            local = (host_ids[in_shard] - start).to(torch.long)
+            staged[in_shard] = (
+                raw.index_select(0, local).view(self.weight.dtype).to(torch.bfloat16)
+            )
+        return staged
 
+    @eager_on_graph(True, capture_stub=_ple_staged_capture_stub)
+    def gather(
+        self, input_ids: torch.Tensor, out: Optional[torch.Tensor] = None
+    ) -> torch.Tensor:
+        output = self._resolve_gather_output(input_ids, out)
 
+        flat_ids = input_ids.reshape(-1).long()
+        if flat_ids.numel():
+            host_ids = flat_ids.detach().cpu()
+            if self._file_prefetcher is not None:
+                # Already on the host: the hint does not need a second sync.
+                self._file_prefetcher.enqueue(
+                    host_ids,
+                    vocab_start=self.shard_indices.org_vocab_start_index,
+                    vocab_end=self.shard_indices.org_vocab_end_index,
+                )
+            staged = self._read_rows(host_ids)
+            # Blocking on purpose: the slab is reused by the next gather, and
+            # an outstanding async copy out of it would race that overwrite.
+            output.view(-1, self.embedding_dim).copy_(staged)
+        return output
+
