+def ple_file_access_mode(device_index: int = 0) -> str:
+    """Which side can dereference a file-backed table on this device.
+
+    ``direct`` -- the gather kernel reads the pageable mapping through the host
+    page tables. No host round trip and no graph break, but only where the
+    device reports ``cudaDevAttrPageableMemoryAccessUsesHostPageTables``.
+
+    ``staged`` -- the host reads the rows out of the mapping and copies them
+    over. Works on any device that can read a file and allocate pinned memory,
+    at the cost of the round trip.
+    """
+    return "direct" if device_uses_host_page_tables(device_index) else "staged"
+
+
+def check_ple_offload_backend_supported(backend: str, device_index: int = 0) -> None:
+    """Fail fast at load time rather than on the first gather or replay."""
+    if backend == "file":
+        check_file_backend_supported(device_index)
+        return
+    if backend == "file-staged":
+        if not torch.cuda.is_available():
+            raise RuntimeError(
+                "--ple-offload-backend file-staged stages rows into device "
+                "memory and needs CUDA"
+            )
+        try:
+            torch.empty(1, dtype=torch.uint8, pin_memory=True)
+        except Exception as exc:
+            raise RuntimeError(
+                "--ple-offload-backend file-staged stages rows through pinned "
+                f"host memory, which is unavailable here: {exc}"
+            ) from exc
+        return
+    if backend != "pinned":
+        raise ValueError(
+            f"unknown PLE offload backend {backend!r}; choose from "
+            f"{PLE_OFFLOAD_BACKENDS}"
         )
 
 
